SELECT TOP 50000 source_id, designation, ra, dec, ra_error, dec_error, parallax, parallax_error, pmra, pmdec, pmra_error, pmdec_error, radial_velocity, radial_velocity_error, phot_g_mean_mag, phot_bp_mean_mag, phot_rp_mean_mag, bp_rp, ruwe, ref_epoch, astrometric_params_solved, visibility_periods_used FROM gaiadr3.gaia_source WHERE parallax > 0 AND parallax_error > 0 AND parallax_over_error >= 10 AND phot_g_mean_mag <= 15 AND ruwe < 1.4 ORDER BY phot_g_mean_mag ASC, source_id ASC
